class_name L
## Перевод строк. Тексты в коде и сценах написаны по-русски; английский —
## в словаре StringsEn. Язык выбирает игрок (GameState.set_language).
##
## Целые строки интерфейса (подписи кнопок, сообщения, реплики) переводятся
## сами там, где показываются. Строки с подстановкой переводятся до неё:
##   L.t("Монеты: %d") % coins


## Строка на текущем языке (если перевода нет — она сама).
static func t(text: String) -> String:
	if text == "":
		return ""
	return String(TranslationServer.translate(text))
